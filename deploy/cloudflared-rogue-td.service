[Unit]
Description=Cloudflare Tunnel for Abyss Tower (game.leyanwc.xyz)
After=network-online.target rogue-td.service
Wants=network-online.target

[Service]
Type=simple
User=wenjin
Group=wenjin
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel --config /home/wenjin/.cloudflared/config.yml run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
