{
  "name": "abyss-tower",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "渊塔守卫 · 肉鸽塔防（零依赖，Node 内置 http + SQLite）",
  "scripts": {
    "start": "node --no-warnings server/index.mjs",
    "dev": "node --watch --no-warnings server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:changed": "node --no-warnings scripts/test-changed.mjs --run",
    "check:syntax": "find public/js server tests scripts -type f \\( -name '*.js' -o -name '*.mjs' \\) -print0 | xargs -0 -r -n1 node --check",
    "check:imports": "node --no-warnings scripts/import-graph.mjs",
    "check:dead-exports": "node --no-warnings scripts/dead-exports.mjs",
    "smoke": "node tests/browser-smoke.mjs",
    "flow": "node tests/browser-flow.mjs",
    "test:settings": "node tests/browser-settings.mjs",
    "test:relics": "node tests/browser-relics.mjs",
    "test:mobile": "node tests/browser-mobile.mjs",
    "test:map": "node tests/browser-map.mjs",
    "test:auth": "node --test tests/auth.test.mjs",
    "test:auth:ui": "node tests/browser-auth.mjs",
    "verify:browser": "npm run smoke && npm run flow && npm run test:relics && npm run test:settings && npm run test:mobile && npm run test:map && npm run test:auth:ui",
    "perf": "node tests/dynamic-perf.mjs",
    "balance": "node tests/balance-sim.mjs 40",
    "balance:write": "node tests/balance-sim.mjs 40 --write",
    "sweep": "node tests/balance-sweep.mjs 20",
    "backup": "node --no-warnings scripts/backup.mjs"
  },
  "engines": {
    "node": ">=22.5"
  }
}
